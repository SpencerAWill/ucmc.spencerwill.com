{
  "name": "ucmc.spencerwill.com",
  "version": "0.1.0",
  "description": "The software system for the University of Cincinnati's Mountaineering Club",
  "scripts": {
    "prepare": "husky",
    "postinstall": "git submodule update --init --remote --merge",
    "commit": "czg",
    "wiki:push": "git -C .wiki push"
  },
  "keywords": [],
  "author": "Spencer Will",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/config-pnpm-scopes": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "czg": "^1.13.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
