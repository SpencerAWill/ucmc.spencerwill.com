{
  "name": "spencerwill.com",
  "version": "0.1.0",
  "description": "The software system for the University of Cincinnati's Mountaineering Club",
  "scripts": {
    "prepare": "husky",
    "commit": "czg",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "knip": "pnpm -r --if-present run knip",
    "test": "pnpm -r --if-present run test",
    "db:drift": "pnpm -r --if-present run db:drift",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run db:drift && pnpm run test"
  },
  "keywords": [],
  "author": "Spencer Will",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/config-pnpm-scopes": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "czg": "^1.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
