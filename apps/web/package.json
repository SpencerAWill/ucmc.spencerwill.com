{
  "name": "ucmc-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "dev": "pnpm run generate:sitemap && vite dev --port 3000",
    "build": "pnpm run generate:sitemap && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "pnpm run build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ucmc-web-dev --local",
    "db:seed:local": "tsx drizzle/seed.ts",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build"
  },
  "dependencies": {
