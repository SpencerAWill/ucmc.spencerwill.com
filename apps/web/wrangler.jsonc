{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top-level = dev config. @cloudflare/vite-plugin reads top-level only,
  // so local dev (`pnpm dev`) binds against these values. `wrangler deploy`
  // (no --env) also publishes against this config → the dev worker.
  //
  // env.production overrides for prod via `wrangler deploy --env production`.
  //
  // ---- D1 database_id / KV id ----
  // Both the D1 `database_id` and KV `kv_namespaces[].id` values below are
  // placeholders. web-deploy.yml fetches the real UUIDs from the Pulumi
  // `d1DatabaseId` and `kvNamespaceId` stack outputs and rewrites this file
  // via `sed` before running migrations/deploy. Each environment uses a
  // distinct placeholder so the per-env `sed` replacement only rewrites its
  // own value (dev: 00000000/22222222; prod: 11111111/33333333). Miniflare
  // ignores these IDs locally (keys on binding name), so the placeholders
  // are fine for `pnpm dev`.
  "name": "ucmc-web-dev",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Custom worker module that re-exports TanStack Start's `fetch`
  // handler and adds a `scheduled` handler so cron triggers below
  // reach the retention sweeps. See `src/server-entry.ts`.
  "main": "src/server-entry.ts",
  // Daily retention sweeps. 08:00 UTC = 03:00 EST / 04:00 EDT —
  // overnight in the US Midwest, well outside any plausible
  // member-traffic window. Daily rather than weekly so the
  // privacy-page promises ("rejected after 30 days", etc.) never
  // drift by more than a day. Same schedule for dev + prod; dev runs
  // against an empty bucket most of the time, which is fine.
  "triggers": {
    "crons": ["0 8 * * *"],
  },
  // Workers Logs: structured logs + invocation traces viewable in the
  // Cloudflare dashboard (~7 day retention) and streamable via `wrangler
  // tail`. `head_sampling_rate: 1` logs 100% of invocations — fine at our
  // traffic; drop it if volume grows. Purely a worker-config setting, so
  // Pulumi and the deploy workflow need no changes; `wrangler deploy`
  // applies it on the next push.
  //
  // PII discipline: any `console.*` call that touches user-shaped data
  // is expected to redact via `src/server/log/redact.server.ts` —
  // `redactEmail` for addresses, `redactUrl` for tokens-in-query,
  // `redactString` for freeform text. Workers Logs is dashboard-readable
  // by anyone with Cloudflare access on the account; treat it as a
  // PII-bounded surface, not an internal-only one.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ucmc-web-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  // R2 bindings are name-based (no generated UUID), so there's no placeholder
  // injection step at deploy time — the bucket_name below IS the real name,
  // managed by Pulumi. Miniflare also keys on bucket_name locally, so `pnpm
  // dev` uses a simulated namespace under apps/web/.wrangler/state/v3/r2/.
  //
  // Two buckets, by access policy:
  //  - BUCKET_PRIVATE: worker-mediated reads only. Default for any new
  //    media; future private uploads (waivers, internal trip reports,
  //    gear inventory photos) land here.
  //  - BUCKET_PUBLIC:  bound to a Cloudflare R2 custom domain
  //    (cdn.{dev.,}ucmc.spencerwill.com), so reads bypass the worker
  //    entirely. URL bytes are publicly readable; rely on
  //    content-hashed keys + opaque public IDs for unguessability.
  //    Avatars + landing images live here.
  "r2_buckets": [
    {
      "binding": "BUCKET_PRIVATE",
      "bucket_name": "ucmc-web-dev-storage",
    },
    {
      "binding": "BUCKET_PUBLIC",
      "bucket_name": "ucmc-web-dev-public-storage",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "22222222-2222-2222-2222-222222222222",
    },
  ],
  // Rate Limiting bindings live under `unsafe` in wrangler config even
  // though the runtime feature is GA — "unsafe" here refers to wrangler's
  // config-schema stability (the shape may change in a future release),
  // NOT runtime safety. Cloudflare's docs prescribe this exact placement
  // today; D1/R2/KV/Queues all passed through `unsafe.bindings` before
  // getting dedicated top-level keys, and rate limit is expected to
  // follow the same path.
  //
  // The `namespace_id` is a worker-local unique integer (not an account
  // resource, so nothing to provision in Pulumi). Dev and prod use
  // different IDs so their counters are isolated. Miniflare simulates
  // the binding in-memory for local dev.
  "unsafe": {
    "bindings": [
      {
        "name": "HEALTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 },
      },
      // Shared limiter for every auth endpoint. Callers key by
      // `ip:<addr>` or `email:<normalized>` (see `server/rate-limit`).
      // 10 req / 60 s per key absorbs a curious user retrying magic
      // links without letting a script enumerate or flood.
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 10, "period": 60 },
      },
      // Avatar uploads are keyed by `user:<userId>` so a signed-in
      // member can't burn R2 PUTs by retrying the form. 5 / 60 s is
      // generous for a human cropping a photo.
      {
        "name": "UPLOAD_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3001",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
  "env": {
    "production": {
      "name": "ucmc-web",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      // Inherit retention-cron schedule from the top-level config.
      // Cloudflare doesn't merge `triggers` from parent env, so this
      // has to be repeated explicitly per env.
      "triggers": {
        "crons": ["0 8 * * *"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ucmc-web",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET_PRIVATE",
          "bucket_name": "ucmc-web-storage",
        },
        {
          "binding": "BUCKET_PUBLIC",
          "bucket_name": "ucmc-web-public-storage",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "33333333-3333-3333-3333-333333333333",
        },
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "HEALTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 20, "period": 60 },
          },
          {
            "name": "AUTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "2002",
            "simple": { "limit": 10, "period": 60 },
          },
          {
            "name": "UPLOAD_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "3002",
            "simple": { "limit": 5, "period": 60 },
          },
        ],
      },
    },
  },
}
