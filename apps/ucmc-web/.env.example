# Copy to .env.local (gitignored) and fill in. Loaded automatically by
# `wrangler dev` / `@cloudflare/vite-plugin` during `pnpm dev`.
#
# Precedence (most → least specific, merged by wrangler v4+):
#   .env.<mode>.local  >  .env.local  >  .env.<mode>  >  .env
# Host process env also wins over any file because the devcontainer sets
# CLOUDFLARE_INCLUDE_PROCESS_ENV=true — export VAR in your shell to override.
#
# This file is LOCAL-DEV ONLY. Deployed dev/prod Workers get the same vars
# from Pulumi (`wrangler deploy --var`) and GitHub secrets (`wrangler secret
# put`) — see .github/workflows/web-deploy.yml. Missing any required var
# below will crash the server on the first request that reads it.

# ── Required for auth ────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=UCMC (local)
RESEND_FROM=noreply@localhost
RESEND_FROM_NAME=UCMC (local)

# ── Dev mailbox (Mailpit) ────────────────────────────────────────────────
# When MAILPIT_URL is set AND RESEND_API_KEY is absent, emails are sent
# to the Mailpit sidecar's HTTP API. Devs see magic links at
# http://localhost:8025.
#
# At least ONE of MAILPIT_URL or RESEND_API_KEY must be set — the
# email sender throws an `EmailNotConfiguredError` if neither is
# configured, so magic-link requests would fail at send time. (An
# earlier revision had a console-log fallback; it was removed because
# it either dumped magic-link URLs into Workers Logs or silently
# swallowed them, both of which are wrong.)
MAILPIT_URL=http://mailpit:8025

# ── Secrets ──────────────────────────────────────────────────────────────
# Set RESEND_API_KEY in production. In development, leave it unset
# and rely on MAILPIT_URL above. Setting RESEND_API_KEY always wins
# over MAILPIT_URL when both are configured.
RESEND_API_KEY=

# HMAC signing key for the short-lived email-verification proof cookie.
# Must be >= 32 bytes of entropy. In deployed envs, set once per env via:
#   wrangler secret put SESSION_SECRET [--env production]
# Locally, any 32+ byte random string works. Rotating this value
# invalidates all outstanding proof cookies (desirable on compromise).
SESSION_SECRET=

# ── Turnstile (anti-bot) ──────────────────────────────────────────────────
# Leave both unset for local dev without a Turnstile widget — the form
# skips the challenge and the server bypasses verification. For deployed
# envs, create a widget in the Cloudflare dashboard and set both values.
# Cloudflare's always-pass test keys (useful for local testing):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public R2 CDN (avatars + landing images) ─────────────────────────────
# Hostname (no scheme, no trailing slash) of the Cloudflare R2 custom
# domain that fronts the public bucket. When set, avatar / landing image
# URLs emit https://${VITE_R2_PUBLIC_HOST}/<key> and bytes are served
# directly from the R2 edge — the worker never sees the request.
# When unset (this default), URLs fall back to the worker-mediated
# /api/avatars/* and /api/landing/* routes; Miniflare serves R2 from
# apps/ucmc-web/.wrangler/state/v3/r2/ in local dev. Provisioned per env by
# the `cloudflare.R2CustomDomain` resource in `infra/index.ts`; deployed
# envs read the value from the Pulumi `r2PublicHost` stack output via
# web-deploy.yml at build time (Vite bakes it into the client bundle).
VITE_R2_PUBLIC_HOST=

# ── GitHub feedback mirror ───────────────────────────────────────────────
# When both are set, the /feedback submit action also opens a GitHub
# issue against FEEDBACK_GITHUB_REPO ("owner/name") using a fine-grained
# PAT scoped to Issues: read & write on that repo. Leave unset for local
# dev — the submission still lands in D1 and the mirror call is skipped.
# In deployed envs both are pushed via `wrangler secret put` from the
# matching GitHub environment secret (see web-deploy.yml). The mirror is
# best-effort: GitHub failures never block the user-visible submit.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=

# ── Seeding (db:seed:local only; not read at runtime) ────────────────────
# Email used as the seeded system_admin. This user is inserted with
# status='approved' so they can sign in on day one without the approval
# flow.
SEED_ADMIN_EMAIL=you@example.com
