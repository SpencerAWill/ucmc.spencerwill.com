{
  "name": "UCMC Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "TZ": "${localEnv:TZ:America/New_York}"
  },
  // There is deliberately no `forwardPorts` here. 3000 / 4173 / 6006 are
  // PUBLISHED by docker-compose.yml instead, so they reach the host even when
  // no VS Code window is attached — Zed and a headless `devcontainer up` get
  // them too, which forwarding cannot do. Listing a published port here as
  // well makes VS Code find the host port taken and silently remap it to a
  // random one: microsoft/vscode-remote-release#3025.
  //
  // These attributes are still worth keeping: they label the published ports
  // in the Ports panel and set what VS Code does when it notices them.
  "portsAttributes": {
    "3000": {
      "label": "Web (Vite)",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Web (vite preview)",
      "onAutoForward": "silent"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "silent"
    },
    // Published by the mailpit SERVICE, not by this container, so it reaches
    // the host on its own. Both addresses are correct from their own side:
    // http://localhost:8025 from a host browser, http://mailpit:8025 from
    // inside the container (compose DNS).
    "8025": {
      "label": "Mailpit (dev inbox)",
      "onAutoForward": "silent"
    }
  },
  // Runs on the HOST before the container exists — pre-creates the bind
  // source for ~/.config/gh so Docker doesn't invent it root-owned.
  "initializeCommand": [".devcontainer/initialize.sh"],
  // Every in-container hook routes through lifecycle.sh so the ordering and
  // the reason each step lives at its stage stay readable in one file.
  // Dependency install is in `updateContentCommand`, not `postCreateCommand`
  // — that hook also fires when prebuilt content refreshes, so a lockfile
  // change is picked up without a full rebuild.
  "onCreateCommand": ".devcontainer/lifecycle.sh on-create",
  "updateContentCommand": ".devcontainer/lifecycle.sh update-content",
  "postCreateCommand": ".devcontainer/lifecycle.sh post-create",
  "postStartCommand": ".devcontainer/lifecycle.sh post-start",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "vitest.explorer",
        "yoavbls.pretty-ts-errors",
        "usernamehw.errorlens",
        "pulumi.pulumi-vscode-tools",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "mikestead.dotenv",
        "streetsidesoftware.code-spell-checker",
        "christian-kohler.path-intellisense",
        "formulahendry.auto-rename-tag",
        "vivaxy.vscode-conventional-commits"
      ]
    }
  }
}
