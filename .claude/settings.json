{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(apps/ucmc-web/src/routeTree.gen.ts)",
      "Edit(**/*.gen.ts)",
      "Edit(**/*.gen.tsx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated-file-edits.sh",
            "timeout": 10,
            "statusMessage": "Checking for generated-file edits"
          }
        ]
      }
    ]
  }
}
